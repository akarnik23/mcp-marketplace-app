# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Database
# For development (SQLite):
DATABASE_URL=sqlite:///./marketplace.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/marketplace

# JWT Secret (generate a random 32-character string)
JWT_SECRET_KEY=your_jwt_secret_key

# Encryption Key (generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Smithery API key for fetching MCP servers
SMITHERY_API_KEY=your_smithery_api_key_here

# Note: Render API keys are now provided by users during deployment
# No need to set RENDER_API_KEY here
